 # ---------------------------------------------------------------------------
 # AI Card Tests
 # ---------------------------------------------------------------------------
+
+
+# ---------------------------------------------------------------------------
+# Business ACK and exact message reaction ownership
+# ---------------------------------------------------------------------------
+
+class TestBusinessAckAndReactionOwnership:
+
+    @pytest.mark.asyncio
+    async def test_http_200_with_nonzero_errcode_is_a_failed_send(self):
+        from plugins.platforms.dingtalk.adapter import DingTalkAdapter
+        adapter = DingTalkAdapter(PlatformConfig(enabled=True))
+        response = MagicMock(status_code=200, text='{"errcode":400,"errmsg":"invalid"}')
+        response.json.return_value = {"errcode": 400, "errmsg": "invalid"}
+        adapter._http_client = AsyncMock()
+        adapter._http_client.post = AsyncMock(return_value=response)
+
+        result = await adapter.send(
+            "chat-1", "answer",
+            metadata={"session_webhook": "https://api.dingtalk.com/x"},
+        )
+
+        assert result.success is False
+        assert "errcode=400" in result.error
+
+    @pytest.mark.asyncio
+    async def test_done_reaction_uses_exact_reply_message(self):
+        from plugins.platforms.dingtalk.adapter import DingTalkAdapter
+        adapter = DingTalkAdapter(PlatformConfig(enabled=True))
+        first = SimpleNamespace(message_id="msg-1", conversation_id="chat-1")
+        second = SimpleNamespace(message_id="msg-2", conversation_id="chat-1")
+        adapter._message_contexts_by_id = {"msg-1": first, "msg-2": second}
+        adapter._message_contexts["chat-1"] = second
+        response = MagicMock(status_code=200)
+        response.json.return_value = {"errcode": 0, "errmsg": "ok"}
+        adapter._http_client = AsyncMock()
+        adapter._http_client.post = AsyncMock(return_value=response)
+        calls = []
+
+        async def fake_emotion(msg_id, conversation_id, emoji_name, *, recall=False):
+            calls.append((msg_id, conversation_id, recall))
+
+        adapter._send_emotion = fake_emotion
+        result = await adapter.send(
+            "chat-1", "answer", reply_to="msg-1",
+            metadata={"session_webhook": "https://api.dingtalk.com/x"},
+        )
+        if adapter._bg_tasks:
+            await asyncio.gather(*list(adapter._bg_tasks))
+
+        assert result.success is True
+        assert len(calls) == 2
+        assert {call[0] for call in calls} == {"msg-1"}
+        assert all(call[1] == "chat-1" for call in calls)
+
+    @pytest.mark.asyncio
+    async def test_missing_exact_message_does_not_use_later_chat_sibling(self):
+        from plugins.platforms.dingtalk.adapter import DingTalkAdapter
+        adapter = DingTalkAdapter(PlatformConfig(enabled=True))
+        adapter._message_contexts["chat-1"] = SimpleNamespace(
+            message_id="later-message", conversation_id="chat-1",
+        )
+        adapter._send_emotion = AsyncMock()
+
+        adapter._fire_done_reaction("chat-1", "missing-message")
+        await asyncio.sleep(0)
+
+        adapter._send_emotion.assert_not_called()
+        assert not adapter._bg_tasks
+
+
+class TestThinkingReactionGate:
+
+    @staticmethod
+    def _message(*, mentioned=False):
+        return SimpleNamespace(
+            message_id="msg-1",
+            conversation_id="chat-1",
+            conversation_type="2",
+            sender_id="user-1",
+            sender_staff_id="staff-1",
+            sender_nick="user",
+            text={"content": "hello"},
+            rich_text_content=None,
+            rich_text=None,
+            image_content=None,
+            extensions={},
+            message_type="text",
+            session_webhook="",
+            session_webhook_expired_time=0,
+            create_at=0,
+            conversation_title="group",
+            is_in_at_list=mentioned,
+        )
+
+    @pytest.mark.asyncio
+    async def test_non_mentioned_group_message_gets_no_thinking_reaction(self):
+        from plugins.platforms.dingtalk.adapter import DingTalkAdapter
+        adapter = DingTalkAdapter(PlatformConfig(
+            enabled=True, extra={"require_mention": True},
+        ))
+        adapter._send_emotion = AsyncMock()
+        adapter._resolve_media_codes = AsyncMock()
+        adapter.handle_message = AsyncMock()
+
+        await adapter._on_message(self._message(mentioned=False))
+
+        adapter._send_emotion.assert_not_called()
+        adapter.handle_message.assert_not_called()
+
+    @pytest.mark.asyncio
+    async def test_accepted_group_message_gets_thinking_after_gate(self):
+        from plugins.platforms.dingtalk.adapter import DingTalkAdapter
+        adapter = DingTalkAdapter(PlatformConfig(
+            enabled=True, extra={"require_mention": True},
+        ))
+        calls = []
+
+        async def fake_emotion(msg_id, conversation_id, emoji_name, *, recall=False):
+            calls.append((msg_id, conversation_id, recall))
+
+        adapter._send_emotion = fake_emotion
+        adapter._resolve_media_codes = AsyncMock()
+        adapter.handle_message = AsyncMock()
+
+        await adapter._on_message(self._message(mentioned=True))
+        if adapter._bg_tasks:
+            await asyncio.gather(*list(adapter._bg_tasks))
+
+        assert calls == [("msg-1", "chat-1", False)]
+        adapter.handle_message.assert_awaited_once()
